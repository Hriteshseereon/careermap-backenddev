# CareerMap backend — environment variables (names and comments only; never commit real values).
# Copy to .env (local) or set in the Render dashboard. Use long random values for every secret.

# ── Server ────────────────────────────────────────────────────────────────────
# Port the API listens on (Render sets this automatically).
PORT=
# "production" hides internal error details in API error responses.
NODE_ENV=
# Number of reverse-proxy hops in front of the API (Render = 1, the default). Also accepts
# "true"/"false" or a comma-separated IP/subnet list. Needed for real client IPs (chatbot rate limits).
TRUST_PROXY=
# Max size of one uploaded file in MB (default 25).
UPLOAD_MAX_MB=

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL=

# ── Token secrets (all required, all different) ──────────────────────────────
# Student access + temporary signup tokens.
JWT_ACCESS_SECRET=
# Student refresh tokens.
JWT_REFRESH_SECRET=
# Student password-reset links.
JWT_RESET_SECRET=
# Admin access tokens.
ADMIN_JWT_ACCESS_SECRET=
# Admin refresh tokens.
ADMIN_JWT_REFRESH_SECRET=
# Staff tokens (admin portal staff login).
STAFF_SECRET=
# Institute portal tokens.
INSTITUTE_SECRET=

# ── Admin bootstrap ──────────────────────────────────────────────────────────
# POST /api/admin/auth/signup needs an admin token. Only while the AdminUsers table is EMPTY,
# the first admin can be created by sending this value in the "x-admin-bootstrap-secret" header.
# Leave unset after the first admin exists.
ADMIN_BOOTSTRAP_SECRET=

# ── OTP login / signup ───────────────────────────────────────────────────────
# "response" (default): the OTP is returned in the send-otp response and shown in the app popup
#   (SMS switched off). WARNING: anyone who knows a mobile number can then log in as that user.
# "sms": the OTP is sent and verified by Twilio Verify and never returned or logged. Use in production.
OTP_DELIVERY=
# Optional fixed OTP accepted for every account (testing only). Unset = no master OTP.
MASTER_OTP=
# Twilio Verify (required only when OTP_DELIVERY=sms).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
# Also used to verify payment signatures for plans and mentor bookings.
RAZORPAY_KEY_SECRET=

# ── E-mail ───────────────────────────────────────────────────────────────────
# Priority: BREVO_API_KEY, then RESEND_API_KEY, then Gmail SMTP (EMAIL_USER / EMAIL_PASS).
BREVO_API_KEY=
RESEND_API_KEY=
# Sender address for Resend (e.g. CareerMap <noreply@your-domain>).
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=
# Web portal base URL used in e-mail links (password reset, reports, institute login).
FRONTEND_URL=

# ── File storage (AWS S3) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# ── Career Bee chatbot ───────────────────────────────────────────────────────
# Anthropic API key. Without it the bot still answers with its built-in fallback replies.
ANTHROPIC_API_KEY=
# Model id (default claude-haiku-5-5).
CHATBOT_MODEL=
# Max tokens per reply (default 700).
CHATBOT_MAX_TOKENS=
# Timeout for one AI call in ms (default 25000).
CHATBOT_TIMEOUT_MS=
# Rate limits per logged-in user / per guest IP (defaults 10/min, 5/min, 150/day, 30/day).
CHATBOT_USER_PER_MINUTE=
CHATBOT_GUEST_PER_MINUTE=
CHATBOT_USER_PER_DAY=
CHATBOT_GUEST_PER_DAY=

# ── One-off legacy data migration scripts only (src/migration) ───────────────
# The MySQL password that used to be hard-coded in src/migration/config/mysql.js must be rotated.
MIGRATION_MYSQL_HOST=
MIGRATION_MYSQL_USER=
MIGRATION_MYSQL_PASSWORD=
MIGRATION_MYSQL_DATABASE=
# Overall deadline for one Career Bee answer across all tool rounds (ms, default 45000)
CHATBOT_TOTAL_TIMEOUT_MS=
# AI answers allowed per server instance per UTC day before switching to fallback answers (default 5000)
CHATBOT_GLOBAL_PER_DAY=
# Career Bee requests per network address per minute, for everyone (default 40)
CHATBOT_IP_PER_MINUTE=
